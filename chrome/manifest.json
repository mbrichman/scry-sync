{
    "manifest_version": 3,
    "name": "Scry Sync",
    "version": "3.6.0",
    "description": "Sync your Claude.ai and ChatGPT conversations (with images and file originals), and your claude.ai artifacts, into Scry.",
      "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "tabs",
    "alarms"
  ],
    "host_permissions": [
      "https://claude.ai/*",
      "https://chatgpt.com/*",
      "https://chat.openai.com/*",
      "https://*.oaiusercontent.com/*",
      "https://images.openai.com/*",
      "https://*.frame.claudeusercontent.com/*"
    ],
    "optional_host_permissions": [
      "http://*/*",
      "https://*/*"
    ],
    "action": {
      "default_popup": "popup.html",
      "default_icon": {
        "16": "icon16.png",
        "48": "icon48.png",
        "128": "icon128.png"
      }
    },
      "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "js": ["content.js"],
      "css": ["content.css"]
    },
    {
      "matches": ["https://claude.ai/artifact/*"],
      "js": ["artifact_capture_main.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://claude.ai/artifact/*"],
      "js": ["artifact_capture_relay.js"],
      "run_at": "document_start"
    }
  ],
    "background": {
      "service_worker": "background.js"
    },
      "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "options_page": "options.html",
  "web_accessible_resources": [
    {
      "resources": ["browse.html"],
      "matches": ["<all_urls>"]
    }
  ]
  }